# Copy to .env and fill in. Never commit real values.

# Claude (conversation). AWAAZ_MODEL defaults to claude-haiku-4-5 for latency (spec §6).
ANTHROPIC_API_KEY=
# AWAAZ_MODEL=claude-haiku-4-5

# Database: SQLite for local dev, Supabase Postgres in production
# (Supabase -> Project Settings -> Database -> connection string, "Session" pooler).
DATABASE_URL=sqlite:///awaaz.db
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Public HTTPS URL of this server (Vapi calls it).
PUBLIC_BASE_URL=https://awaaz.example.com
# Random string; Vapi sends it back in the x-awaaz-secret header.
AWAAZ_WEBHOOK_SECRET=
# Random string; signs dashboard session cookies.
AWAAZ_SESSION_SECRET=

# Vapi private API key (only used to delete expired recordings).
VAPI_API_KEY=

# WhatsApp Cloud API (Meta). Leave empty to log messages instead of sending.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with 4 body params: name, day, time, business.
WHATSAPP_BOOKING_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=ur

# HOSTIX keys are referenced per business as env:NAME (integrations.api_key_ref).
# HOSTIX_KEY_ALNOOR=
